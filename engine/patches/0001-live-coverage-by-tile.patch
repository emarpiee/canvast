+    /// The coverage tiles ([`COV_TILE`] pixels a side) touched since the last call (or `composite`),
+    /// and forget them: what a live preview that composites its own paint redraws, tile by tile.
+    pub fn take_dirty_tiles(&mut self) -> Vec<(i32, i32)> {
+        if let Some(d) = self.dual.as_mut() {
+            d.dirty.clear();
+        }
+        self.cov.take_dirty()
+    }
+
+    /// Final coverage of one coverage tile into `out` ([`COV_TILE`]² values, rows): the same as
+    /// [`coverage_at`](Self::coverage_at) at each of its pixels, read in one pass when no stroke-level
+    /// mask (Wet Edges, Dual Brush, a texture over the whole stroke) applies.
+    pub fn coverage_tile(&self, tx: i32, ty: i32, out: &mut [f32]) {
+        let n = COV_TILE as usize;
+        let Some(t) = self.cov.tiles.get(&(tx, ty)) else {
+            out.fill(0.0);
+            return;
+        };
+        let plain = t.depth.is_empty() && self.dual.is_none() && (self.ctx.texture.is_none() || self.ctx.brush.texture.each_tip);
+        if plain {
+            for (o, &c) in out.iter_mut().zip(&t.cov) {
+                *o = c.max(0.0);
+            }
+            return;
+        }
+        for (i, o) in out.iter_mut().enumerate().take(n * n) {
+            *o = self.coverage_at(tx * COV_TILE + (i % n) as i32, ty * COV_TILE + (i / n) as i32);
+        }
+    }
+
