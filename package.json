{
  "name": "canvast",
  "version": "0.8.0",
  "private": true,
  "description": "canvast — an offline-first endless canvas that ships as a single HTML file",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build.mjs --mode=production",
    "build:debug": "node scripts/build.mjs --mode=debug",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:full": "npm run build && playwright test -c playwright.full.config.ts",
    "check:offline": "node scripts/check-offline.mjs dist/canvast.html",
    "check:names": "node scripts/check-names.mjs dist/canvast.html",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e && npm run check:offline && npm run check:names",
    "test:full": "npm run typecheck && npm run test:unit && npm run test:e2e:full && npm run check:offline && npm run check:names",
    "bench": "npm run build && playwright test -c playwright.bench.config.ts",
    "electron": "npm run build && electron electron/main.cjs",
    "dist:appimage": "npm run build && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lucide-static": "1.48.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "main": "electron/main.cjs",
  "author": "emarpiee",
  "build": {
    "appId": "app.canvast",
    "productName": "canvast",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "dist/canvast.html",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "artifactName": "canvast-${version}-${arch}.AppImage"
    }
  }
}
