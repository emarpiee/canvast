{
  "name": "canvast",
  "version": "0.50.58",
  "private": true,
  "description": "canvast — an offline-first endless canvas that ships as a single HTML file",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "build:all": "node scripts/build.mjs && node scripts/package-desktop.mjs",
    "desktop": "node scripts/build.mjs && node scripts/build-desktop.mjs && electron dist-desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.desktop.json",
    "test:unit": "vitest run",
    "test:snap": "node scripts/test-snap.mjs",
    "test:status": "node scripts/test-status.mjs",
    "qualify": "node scripts/qualify.mjs",
    "test:e2e": "node scripts/test-snap.mjs",
    "test:e2e:full": "node scripts/test-snap.mjs -c playwright.full.config.ts",
    "check:offline": "node scripts/check-offline.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:names": "node scripts/check-names.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "test": "npm run typecheck && npm run test:unit && node scripts/test-affected.mjs && npm run check:tokens && npm run check:storage && npm run check:picker && npm run check:patterns",
    "test:affected": "node scripts/test-affected.mjs",
    "test:group": "node scripts/test-affected.mjs --groups",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:e2e && npm run check:tokens && npm run check:storage && npm run check:picker && npm run check:patterns",
    "check:groups": "node scripts/test-affected.mjs --check",
    "test:full": "npm run typecheck && npm run test:unit && npm run test:e2e:full && npm run check:tokens && npm run check:storage && npm run check:picker && npm run check:patterns",
    "bench": "node scripts/test-snap.mjs -c playwright.bench.config.ts",
    "check:repro": "node scripts/check-repro.mjs",
    "check:picker": "node scripts/check-picker.mjs",
    "check:patterns": "node scripts/check-patterns.mjs",
    "build:picker": "node scripts/build-picker.mjs",
    "build:patterns": "node scripts/build-patterns.mjs",
    "bench:picker": "node scripts/bench-picker.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "electron": "44.7.1",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "gsap": "3.12.5",
    "lucide-static": "1.48.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
