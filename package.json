{
  "name": "canvast",
  "version": "0.63.19",
  "private": true,
  "description": "canvast — an offline-first endless canvas that ships as a single HTML file",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:appimage": "node scripts/package-desktop.mjs appimage",
    "package:deb": "node scripts/package-desktop.mjs deb",
    "package:rpm": "node scripts/package-desktop.mjs rpm",
    "package:tar": "node scripts/package-desktop.mjs tar",
    "build:all": "node scripts/build.mjs && node scripts/package-desktop.mjs",
    "build:appimage": "node scripts/build.mjs && node scripts/package-desktop.mjs appimage",
    "desktop": "node scripts/build.mjs && node scripts/build-desktop.mjs && electron dist-desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.desktop.json",
    "test:unit": "vitest run",
    "test:snap": "node scripts/test-snap.mjs",
    "test:status": "node scripts/test-status.mjs",
    "qualify": "node scripts/qualify.mjs",
    "test:e2e": "node scripts/test-snap.mjs",
    "test:e2e:full": "node scripts/test-snap.mjs -c playwright.full.config.ts",
    "check:offline": "node scripts/check-offline.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:names": "node scripts/check-names.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "check:name-rules": "node scripts/check-name-rules.mjs",
    "check:components": "node scripts/check-components.mjs",
    "check:commands": "node scripts/check-commands.mjs",
    "audit:commands": "node scripts/check-commands.mjs --audit",
    "test": "npm run typecheck && npm run test:unit && node scripts/test-affected.mjs && npm run check:tokens && npm run check:storage && npm run check:picker && npm run check:markdown-editor && npm run check:patterns",
    "test:affected": "node scripts/test-affected.mjs",
    "test:group": "node scripts/test-affected.mjs --groups",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:e2e && npm run check:tokens && npm run check:storage && npm run check:picker && npm run check:markdown-editor && npm run check:patterns",
    "check:groups": "node scripts/test-affected.mjs --check",
    "check:shots": "node scripts/check-shots.mjs",
    "test:full": "npm run typecheck && npm run test:unit && npm run test:e2e:full && npm run check:tokens && npm run check:storage && npm run check:picker && npm run check:markdown-editor && npm run check:patterns",
    "bench": "node scripts/test-snap.mjs -c playwright.bench.config.ts",
    "check:repro": "node scripts/check-repro.mjs",
    "check:picker": "node scripts/check-picker.mjs",
    "check:markdown-editor": "node scripts/check-markdown-editor.mjs",
    "check:patterns": "node scripts/check-patterns.mjs",
    "build:picker": "node scripts/build-picker.mjs",
    "build:patterns": "node scripts/build-patterns.mjs",
    "bench:picker": "node scripts/bench-picker.mjs",
    "release": "node scripts/release.mjs",
    "build:tools": "node scripts/tools/build-tools.mjs",
    "photocraft:check": "node scripts/artcraft/photocraft/check.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@expo-google-fonts/inter": "0.4.2",
    "@lezer/common": "1.5.5",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@playwright/test": "1.64.0",
    "@replit/codemirror-vim": "6.4.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/three": "0.187.0",
    "electron": "44.7.1",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "gsap": "3.12.5",
    "katex": "0.19.1",
    "lucide-static": "1.48.0",
    "mermaid": "12.3.0",
    "pdfjs-dist": "6.5.438",
    "prismjs": "1.30.0",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  }
}
